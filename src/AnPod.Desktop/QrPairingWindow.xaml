<Window x:Class="AnPod.Desktop.QrPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加无线手机" Width="540" Height="720" MinWidth="430" MinHeight="660"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="关闭添加无线手机窗口" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="添加无线手机" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Margin="0,4,0,14" Text="配对仅授权这台电脑；不会开始播放。" FontSize="13"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TabControl x:Name="MethodsTab" SelectionChanged="OnMethodChanged" Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="无线手机添加方式">
                <TabItem Header="扫码配对" FontSize="14">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="电脑和手机需连接同一局域网。手机打开：开发者选项 → 无线调试 → 使用二维码配对设备。"
                                   FontSize="13.5" LineHeight="20" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                        <Border Grid.Row="1" Width="208" Height="208" Margin="0,10,0,0" Padding="8" HorizontalAlignment="Center"
                                Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Image x:Name="QrImageControl" Stretch="Uniform" AutomationProperties.Name="本次无线调试二维码" />
                        </Border>
                        <TextBlock x:Name="QrStatusText" Grid.Row="2" Margin="0,10,0,0" Text="正在准备二维码……"
                                   TextAlignment="Center" FontSize="13.5" Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="配对地址" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="连接地址" Margin="0,5,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PairAddressText" Text="等待扫码" FontSize="12.5" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ConnectAddressText" Text="配对后自动发现" Margin="0,5,0,0" FontSize="12.5" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="RetryQrButton" Grid.Row="4" Margin="0,12,0,0" Content="重新生成并重试" Click="OnRetryQrClick"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="生成新的二维码并重新扫码" />
                    </Grid>
                </TabItem>
                <TabItem Header="配对码" FontSize="14">
                    <StackPanel Margin="14">
                        <TextBlock Text="在手机的「无线调试」中选择「使用配对码配对设备」，然后填写页面显示的配对地址和六位数字。"
                                   FontSize="13.5" LineHeight="20" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,0" Text="配对地址（IP:配对端口）" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBox Margin="0,5,0,0" Height="40" Text="{Binding PairingEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" AutomationProperties.Name="手机显示的配对 IP 地址与端口" />
                        <TextBlock Margin="0,12,0,0" Text="配对码" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBox x:Name="PairCodeBox" Margin="0,5,0,0" Height="40" MaxLength="6"
                                 Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" AutomationProperties.Name="六位数字配对码" />
                        <TextBlock Margin="0,8,0,0" Text="配对端口和连接端口不同。配对后 AnPod 会查找连接地址；这一步不会播放声音。"
                                   FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                        <Button Margin="0,16,0,0" Content="配对并查找连接地址" Click="OnPairCodeClick"
                                IsEnabled="{Binding CanPairWifi}" Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="使用六位配对码并查找手机连接地址" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding WifiStatusMessage}" FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="手动连接" FontSize="14">
                    <StackPanel Margin="14">
                        <TextBlock Text="用于已配对手机，或旧版 Android 的 USB 转 TCP/IP 调试。输入手机无线调试页面显示的地址；旧版 Android 请先按帮助中的步骤通过 USB 开启 TCP/IP 调试。"
                                   FontSize="13.5" LineHeight="20" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,0" Text="连接地址（IP:连接端口）" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBox Margin="0,5,0,0" Height="40" Text="{Binding WifiEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" AutomationProperties.Name="已配对手机的 IP 地址与连接端口" />
                        <Button Margin="0,10,0,0" Content="查找设备" Command="{Binding DiscoverCommand}"
                                IsEnabled="{Binding CanDiscoverWifi}" HorizontalAlignment="Left"
                                Style="{StaticResource LinkButtonStyle}" AutomationProperties.Name="在局域网查找无线连接地址" />
                        <Button Margin="0,10,0,0" Content="连接已配对手机" Click="OnConnectExistingClick"
                                IsEnabled="{Binding CanConnectWifi}" Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="连接已配对的手机但不开始播放" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding WifiStatusMessage}" FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DockPanel>
</Window>
