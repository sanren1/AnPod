<Window x:Class="AnPod.Desktop.WirelessHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无线连接帮助"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border Padding="20,18,20,16">
        <StackPanel>

            <TextBlock Text="无线连接帮助"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrush}" />

            <Border Height="1"
                    Margin="0,12,0,0"
                    Background="{StaticResource BorderBrush}" />

            <!-- Ordered because these are steps, not a list of facts. The first
                 one is the trap that actually stops people: the phone shows two
                 different ports and both look like "the port". -->
            <TextBlock Margin="0,14,0,0"
                       FontSize="12.5"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="1.  配对端口和连接端口不是同一个数字。&#x0a;配对成功后，手机「无线调试」页面上的端口会变成另一个——那个才是「连接」要用的。点「搜索设备」可以自动填上，不用手抄。" />

            <TextBlock Margin="0,12,0,0"
                       FontSize="12.5"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="2.  两台设备必须在同一网络。&#x0a;用 Windows 移动热点时，先在系统设置里开启热点，再让手机加入，然后回到这里配对。" />

            <TextBlock Margin="0,12,0,0"
                       FontSize="12.5"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="3.  公共 Wi-Fi 常开启「客户端隔离」，设备之间互相看不见，会一直连不上。换成手机热点或家庭网络再试。AnPod 不会去关你的防火墙。" />

            <TextBlock Margin="0,12,0,0"
                       FontSize="12.5"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="4.  提示需要重新配对，说明手机上的「无线调试」被关过或手机重启过。重新配对一次即可，已配对的记录会失效。" />

            <TextBlock Margin="0,12,0,0"
                       FontSize="12.5"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="5.  手机息屏后无线调试可能被系统挂起，导致掉线。把 AnPod 的「无线掉线后自动重连」和「自动连接上次设备」都打开，并把手机的省电策略设为「无限制」。" />

            <TextBlock Margin="0,12,0,0"
                       FontSize="12.5"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="6.  无线实在连不上时，改用 USB 连接（数据线）。USB 模式不依赖网络，也不需要配对。" />

            <Border Margin="0,16,0,0"
                    Height="1"
                    Background="{StaticResource BorderBrush}" />

            <Grid Margin="0,14,0,0">
                <Button Content="打开 Windows 移动热点设置"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding OpenHotspotSettingsCommand}"
                        AutomationProperties.Name="打开 Windows 移动热点设置" />
                <Button Content="关闭"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="关闭帮助" />
            </Grid>

        </StackPanel>
    </Border>

</Window>
