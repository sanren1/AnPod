<Window x:Class="AnPod.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnPod"
        Width="420" Height="580" MinWidth="360" MinHeight="500" MaxWidth="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="24" Height="24" Source="/AnPod;component/Assets/icon.ico" />
                    <TextBlock Text="AnPod" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
                <Button Content="设置" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource LinkButtonStyle}" Click="OnSettingsClick"
                        AutomationProperties.Name="打开设置" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel Margin="20,12,20,8">
                <Border Padding="3" Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="USB" GroupName="Transport" Style="{StaticResource ModeSegmentStyle}"
                                     IsChecked="{Binding IsUsbMode, Mode=TwoWay}" IsEnabled="{Binding IsTransportSwitchEnabled}"
                                     AutomationProperties.Name="使用 USB 连接" />
                        <RadioButton Grid.Column="1" Content="Wi-Fi" GroupName="Transport" Style="{StaticResource ModeSegmentStyle}"
                                     IsChecked="{Binding IsWifiMode, Mode=TwoWay}" IsEnabled="{Binding IsTransportSwitchEnabled}"
                                     AutomationProperties.Name="使用 Wi-Fi 连接" />
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="手机" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButtonStyle}"
                                AutomationProperties.Name="刷新手机设备列表" />
                        <Button x:Name="AddPhoneButton" Content="添加手机" Margin="10,0,0,0" Click="OnAddPhoneClick"
                                Style="{StaticResource LinkButtonStyle}" Visibility="{Binding IsWifiMode, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="添加无线手机" />
                        <Button Content="连接帮助" Margin="10,0,0,0" Click="OnHelpClick"
                                Style="{StaticResource LinkButtonStyle}" Visibility="{Binding IsUsbMode, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="查看 USB 连接帮助" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0" Height="64">
                    <ComboBox Height="64" Padding="10,5"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          IsEnabled="{Binding IsDeviceListEnabled}"
                          Style="{StaticResource AppComboBoxStyle}"
                          Background="{DynamicResource CardBrush}" Foreground="{DynamicResource ForegroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" FontSize="14"
                          AutomationProperties.Name="选择连接手机；下拉可查看型号、连接方式和状态">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Serial}" />
                                    <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0" FontSize="12"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TransportText}" VerticalAlignment="Center" Margin="12,0,2,0"
                                           FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding EmptyDeviceHint}" Margin="12,6,42,6" FontSize="12.5" LineHeight="17"
                               Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsDeviceListEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Margin="0,12,0,0" Padding="14,10" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{DynamicResource StatusIdleBrush}" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Ready"><Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Streaming"><Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Fill" Value="{DynamicResource StatusBusyBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Reconnecting"><Setter Property="Fill" Value="{DynamicResource StatusBusyBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Unauthorized"><Setter Property="Fill" Value="{DynamicResource StatusWarnBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusTitle}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button Content="诊断" HorizontalAlignment="Right" Style="{StaticResource LinkButtonStyle}"
                                    Click="OnDiagnosticsClick" AutomationProperties.Name="打开诊断详情" />
                        </Grid>
                        <TextBlock Text="{Binding StatusDetails}" Margin="0,8,0,0" FontSize="14" LineHeight="20"
                                   Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" MaxHeight="96"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Height="1" Margin="0,8,0,6" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding OutputRouteText}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" AutomationProperties.Name="声音输出位置" />
                    </StackPanel>
                </Border>

                <Button Margin="0,10,0,0" Content="{Binding PrimaryActionText}" Command="{Binding PrimaryCommand}"
                        IsEnabled="{Binding CanExecutePrimaryAction}" Height="42"
                        Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="{Binding PrimaryActionText}" />
                <Button Margin="0,4,0,0" Content="断开连接" Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsDisconnectEnabled}" Height="32"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="断开手机音频连接" />

                <Grid Margin="0,10,0,0">
                    <TextBlock Text="播放模式" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <Border Width="192" HorizontalAlignment="Right" Padding="2" Background="{DynamicResource MutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="均衡" GroupName="PlaybackMode" Style="{StaticResource ModeSegmentStyle}"
                                         IsChecked="{Binding IsBalancedPlaybackMode, Mode=TwoWay}" IsEnabled="{Binding IsPlaybackModeSwitchEnabled}"
                                         AutomationProperties.Name="均衡播放模式" />
                            <RadioButton Grid.Column="1" Content="低延迟" GroupName="PlaybackMode" Style="{StaticResource ModeSegmentStyle}"
                                         IsChecked="{Binding IsLowLatencyPlaybackMode, Mode=TwoWay}" IsEnabled="{Binding IsPlaybackModeSwitchEnabled}"
                                         AutomationProperties.Name="低延迟播放模式" />
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding PlaybackModeHint}" Margin="0,4,0,0" FontSize="12" LineHeight="16"
                           Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="帮助" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}"
                        Click="OnHelpClick" AutomationProperties.Name="打开连接帮助" />
                <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
                <Button Content="查看日志" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding OpenLogsCommand}" AutomationProperties.Name="打开日志文件夹" />
            </Grid>
        </Border>
    </Grid>
</Window>
