<Window x:Class="AnPod.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AnPod.Core.Models;assembly=AnPod.Core"
        Title="AnPod 设置" Width="470" Height="400" MinWidth="420" MinHeight="360"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}" Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="忘记无线地址" Style="{StaticResource LinkButtonStyle}" Click="OnForgetAddressClick"
                    IsEnabled="{Binding CanForgetSavedWifiAddress}"
                    AutomationProperties.Name="忘记本地保存的无线地址" />
            <Button Content="完成" Margin="14,0,0,0" Width="88" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="关闭设置" />
        </StackPanel>
        <TabControl Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    AutomationProperties.Name="设置分类">
            <TabItem Header="常规" FontSize="14">
                <StackPanel Margin="14">
                    <TextBlock Text="常规" Style="{StaticResource HeadingTextStyle}" FontSize="18" />
                    <CheckBox Margin="0,18,0,0" Content="关闭窗口时留在系统托盘" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              Style="{StaticResource AppCheckBoxStyle}" FontSize="14" AutomationProperties.Name="关闭窗口时留在系统托盘" />
                    <TextBlock Margin="24,4,0,0" Text="关闭到托盘后，右键托盘图标可退出 AnPod。" FontSize="12.5"
                               Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" Text="外观" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <ComboBox Margin="0,6,0,0" Height="36" SelectedValue="{Binding AppearanceTheme, Mode=TwoWay}" SelectedValuePath="Tag"
                              Style="{StaticResource AppComboBoxStyle}" AutomationProperties.Name="选择外观主题">
                        <ComboBoxItem Content="跟随系统" Tag="{x:Static core:AppearanceTheme.System}" />
                        <ComboBoxItem Content="浅色" Tag="{x:Static core:AppearanceTheme.Light}" />
                        <ComboBoxItem Content="深色" Tag="{x:Static core:AppearanceTheme.Dark}" />
                    </ComboBox>
                    <TextBlock Margin="0,12,0,0" Text="高对比度开启时，界面优先使用 Windows 系统颜色。" FontSize="12.5"
                               Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
            <TabItem Header="连接" FontSize="14">
                <StackPanel Margin="14">
                    <TextBlock Text="连接" Style="{StaticResource HeadingTextStyle}" FontSize="18" />
                    <CheckBox Margin="0,18,0,0" Content="自动连接上次使用的手机" IsChecked="{Binding AutoConnectLastDevice, Mode=TwoWay}"
                              Style="{StaticResource AppCheckBoxStyle}" FontSize="14" AutomationProperties.Name="自动连接上次使用的手机" />
                    <CheckBox Margin="0,12,0,0" Content="无线掉线后尝试重连" IsChecked="{Binding AutoReconnectWifi, Mode=TwoWay}"
                              IsEnabled="{Binding CanReconnectWifi}" Style="{StaticResource AppCheckBoxStyle}" FontSize="14"
                              AutomationProperties.Name="无线掉线后尝试重连" />
                    <TextBlock Margin="24,4,0,0" Text="{Binding ReconnectWifiHint}" FontSize="12.5"
                               Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0" Padding="12" Background="{DynamicResource MutedBrush}" CornerRadius="8">
                        <TextBlock Text="忘记地址只清除 AnPod 保存的连接地址；不会断开 ADB，也不会撤销手机端的配对授权。"
                                   FontSize="13" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="播放" FontSize="14">
                <StackPanel Margin="14">
                    <TextBlock Text="播放" Style="{StaticResource HeadingTextStyle}" FontSize="18" />
                    <TextBlock Margin="0,18,0,0" Text="当前模式" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding PlaybackModeLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding PlaybackModeHint}" FontSize="13.5" LineHeight="20"
                               Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Text="请在主窗口选择模式。播放会话期间不能切换，断开连接后生效。"
                               FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
