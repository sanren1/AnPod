<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Session probe: the runnable check for the two controls being independent.

    The claim under test is "turning the sound off does not drop the phone".
    That cannot be checked without a real device — it is a statement about the
    reverse tunnel, the app_process payload and the TCP socket all surviving a
    pause — so this drives the shipping ConnectionManager end to end.

    Deliberately not in AnPod.sln: it needs a phone plugged in.

    Run it with: dotnet run (project tools/SessionProbe)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SessionProbe</AssemblyName>
    <RootNamespace>AnPod.Tools.SessionProbe</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnPod.Desktop\AnPod.Desktop.csproj" />
  </ItemGroup>

  <!-- Same runtime layout as the shipped app, so the probe exercises the real
       payload and the real capture DLL. -->
  <ItemGroup>
    <None Include="..\..\deps\audio_capture.dll" Link="audio_capture.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\server" Link="server" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\adb.exe" Link="adb.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\AdbWinApi.dll" Link="AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\AdbWinUsbApi.dll" Link="AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
