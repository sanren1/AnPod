<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagnostic probe, not part of the shipped product and deliberately not in
    AnPod.sln. It answers one question that only real hardware can answer:
    "does muting the render endpoint silence WASAPI loopback capture?"

    It references AnPod.Desktop so it exercises the shipping
    PlaybackEndpointMuter and NativeAudioCapture rather than a copy of them.

    Run it with: dotnet run (project tools/CaptureProbe)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CaptureProbe</AssemblyName>
    <RootNamespace>AnPod.Tools.CaptureProbe</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnPod.Desktop\AnPod.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deps\audio_capture.dll"
          Link="audio_capture.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
