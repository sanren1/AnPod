<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI snapshot: renders MainWindow to PNG without a human at the keyboard.

    A XAML rewrite is exactly the kind of change that compiles cleanly and still
    looks wrong — a missing margin, a switch that never moves, a list that
    overflows the window. This builds the real window with the real view model
    and rasterises it, so the layout can be reviewed like any other output.

    Deliberately not in AnPod.sln; it is a development aid, not shipped.

    Run it with: dotnet run (project tools/UiSnapshot), then the output dir.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UiSnapshot</AssemblyName>
    <RootNamespace>AnPod.Tools.UiSnapshot</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnPod.Desktop\AnPod.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deps\audio_capture.dll" Link="audio_capture.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\server" Link="server" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\adb.exe" Link="adb.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\AdbWinApi.dll" Link="AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deps\AdbWinUsbApi.dll" Link="AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
