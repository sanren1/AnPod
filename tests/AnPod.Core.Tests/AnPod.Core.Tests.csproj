<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain console test runner. No xunit/NUnit: the project has no third-party
    dependencies by design (plan §8, "禁止...无必要第三方依赖"), and the checks
    below are assertions over pure functions. Run with `dotnet run`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AnPod.Core.Tests</RootNamespace>
    <AssemblyName>AnPod.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnPod.Core\AnPod.Core.csproj" />
  </ItemGroup>

</Project>
